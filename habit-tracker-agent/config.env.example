# HABITOS — Habit Tracker Agent
# Config file (env-style). All values are optional defaults.

# Path to the JSON data file (habit + check-in history).
# Leave empty for an automatic temp file; use ":memory:" for pure in-memory.
HABITOS_DATA=

# Default target frequency for new habits without an explicit target.
# daily | weekdays | weekly | weekends | (empty = 5 days/week default)
HABITOS_DEFAULT_FREQUENCY=weekdays

# Report greeting tone (used in the weekly text report footer).
HABITOS_REPORT_TONE=cultured

# Categories accepted when adding a habit.
HABITOS_CATEGORIES=health,productivity,learning,fitness,mindfulness,general

# How many ISO weeks the trend command shows by default.
HABITOS_TREND_WEEKS=6
