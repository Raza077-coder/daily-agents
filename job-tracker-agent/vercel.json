{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "jobflow",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "JOBFLOW_DATA_DIR": "/tmp"
  }
}
